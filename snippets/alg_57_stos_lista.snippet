<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Lab 5.7 - Stos listowy</Title>
      <Shortcut>alg_57_stos_lista</Shortcut>
      <Description>Stos LIFO na liście jednokierunkowej.</Description>
      <Author>bearbine</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="csharp"><![CDATA[
using System;

public class StosListowy
{
    private class Node
    {
        public int Value;
        public Node Next;

        public Node(int value)
        {
            Value = value;
            Next = null;
        }
    }

    private Node top;

    public bool CzyPusta()
    {
        return top == null;
    }

    public void Dodaj(int value)
    {
        Node newNode = new Node(value);
        newNode.Next = top;
        top = newNode;
    }

    public int Zdejmij()
    {
        if (CzyPusta())
        {
            Console.WriteLine("Stos jest pusty.");
            return -1;
        }

        int value = top.Value;
        top = top.Next;
        return value;
    }

    public int Podejrzyj()
    {
        if (CzyPusta())
        {
            Console.WriteLine("Stos jest pusty.");
            return -1;
        }

        return top.Value;
    }
}

class Program
{
    static void Main()
    {
        StosListowy stos = new StosListowy();

        stos.Dodaj(10);
        stos.Dodaj(20);
        stos.Dodaj(30);

        Console.WriteLine(stos.Podejrzyj());
        Console.WriteLine(stos.Zdejmij());
        Console.WriteLine(stos.Zdejmij());
        Console.WriteLine(stos.Zdejmij());
    }
}
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>