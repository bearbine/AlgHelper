<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Lab 7.5 - Dijkstra</Title>
      <Shortcut>alg_graf_dijkstra_75</Shortcut>
      <Description>Najkrótsze ścieżki od startu | Namespace-ready: wklejaj wewnątrz namespace { }</Description>
      <Author>bearbine</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="csharp"><![CDATA[
using System;
using System.Collections.Generic;

public class Edge
{
    public string To;
    public int Weight;

    public Edge(string to, int weight)
    {
        To = to;
        Weight = weight;
    }
}

class Program
{
    static Dictionary<string, int> Dijkstra(Dictionary<string, List<Edge>> graph, string start)
    {
        Dictionary<string, int> dist = new Dictionary<string, int>();

        foreach (string vertex in graph.Keys)
        {
            dist[vertex] = int.MaxValue;
        }

        dist[start] = 0;

        PriorityQueue<string, int> pq = new PriorityQueue<string, int>();
        pq.Enqueue(start, 0);

        while (pq.Count > 0)
        {
            pq.TryDequeue(out string current, out int currentDist);

            if (currentDist > dist[current])
            {
                continue;
            }

            foreach (Edge edge in graph[current])
            {
                int newDist = dist[current] + edge.Weight;

                if (newDist < dist[edge.To])
                {
                    dist[edge.To] = newDist;
                    pq.Enqueue(edge.To, newDist);
                }
            }
        }

        return dist;
    }

    static void Main()
    {
        Dictionary<string, List<Edge>> graph = new Dictionary<string, List<Edge>>();

        graph["A"] = new List<Edge>() { new Edge("B", 4), new Edge("C", 2) };
        graph["B"] = new List<Edge>() { new Edge("C", 1), new Edge("D", 5) };
        graph["C"] = new List<Edge>() { new Edge("D", 8), new Edge("E", 10) };
        graph["D"] = new List<Edge>() { new Edge("E", 2) };
        graph["E"] = new List<Edge>();

        Dictionary<string, int> distances = Dijkstra(graph, "A");

        foreach (var item in distances)
        {
            Console.WriteLine(item.Key + ": " + item.Value);
        }
    }
}
]]></Code>
    </Snippet>
  </CodeSnippet>
