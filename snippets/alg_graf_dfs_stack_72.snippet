<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Lab 7.2 - DFS stos</Title>
      <Shortcut>alg_graf_dfs_stack_72</Shortcut>
      <Description>DFS iteracyjny ze stosem | Namespace-ready: wklejaj wewnątrz namespace { }</Description>
      <Author>bearbine</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="csharp"><![CDATA[
using System;
using System.Collections.Generic;

class Program
{
    static void DFS(Dictionary<string, List<string>> graph, string start)
    {
        Stack<string> stack = new Stack<string>();
        HashSet<string> visited = new HashSet<string>();

        stack.Push(start);

        while (stack.Count > 0)
        {
            string vertex = stack.Pop();

            if (!visited.Contains(vertex))
            {
                visited.Add(vertex);
                Console.Write(vertex + " ");

                for (int i = graph[vertex].Count - 1; i >= 0; i--)
                {
                    string neighbor = graph[vertex][i];

                    if (!visited.Contains(neighbor))
                    {
                        stack.Push(neighbor);
                    }
                }
            }
        }
    }

    static void Main()
    {
        Dictionary<string, List<string>> graph = new Dictionary<string, List<string>>();

        graph["A"] = new List<string>() { "B", "E", "D" };
        graph["B"] = new List<string>() { "A", "C", "E" };
        graph["E"] = new List<string>() { "A", "B", "D", "F" };
        graph["D"] = new List<string>() { "A", "E" };
        graph["C"] = new List<string>() { "B" };
        graph["F"] = new List<string>() { "E" };

        DFS(graph, "A");
    }
}
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
