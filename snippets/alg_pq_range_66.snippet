<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Lab 6.6 - Range k arrays</Title>
      <Shortcut>alg_pq_range_66</Shortcut>
      <Description>Najmniejszy przedział dla k posortowanych tablic | Namespace-ready: wklejaj wewnątrz namespace { }</Description>
      <Author>bearbine</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="csharp"><![CDATA[
using System;
using System.Collections.Generic;

public class ElementInfo
{
    public int Value;
    public int ArrayIndex;
    public int ElementIndex;

    public ElementInfo(int value, int arrayIndex, int elementIndex)
    {
        Value = value;
        ArrayIndex = arrayIndex;
        ElementIndex = elementIndex;
    }
}

class Program
{
    static (int L, int R) FindSmallestRange(int[][] arrays)
    {
        PriorityQueue<ElementInfo, int> pq = new PriorityQueue<ElementInfo, int>();
        int currentMax = int.MinValue;

        for (int i = 0; i < arrays.Length; i++)
        {
            ElementInfo element = new ElementInfo(arrays[i][0], i, 0);
            pq.Enqueue(element, element.Value);

            if (element.Value > currentMax)
            {
                currentMax = element.Value;
            }
        }

        int bestL = 0;
        int bestR = int.MaxValue;

        while (pq.Count == arrays.Length)
        {
            ElementInfo currentMin = pq.Dequeue();

            if (currentMax - currentMin.Value < bestR - bestL)
            {
                bestL = currentMin.Value;
                bestR = currentMax;
            }

            int nextIndex = currentMin.ElementIndex + 1;

            if (nextIndex >= arrays[currentMin.ArrayIndex].Length)
            {
                break;
            }

            int nextValue = arrays[currentMin.ArrayIndex][nextIndex];
            ElementInfo nextElement = new ElementInfo(nextValue, currentMin.ArrayIndex, nextIndex);
            pq.Enqueue(nextElement, nextElement.Value);

            if (nextValue > currentMax)
            {
                currentMax = nextValue;
            }
        }

        return (bestL, bestR);
    }

    static void Main()
    {
        int[][] arrays =
        {
            new int[] { 4, 10, 15, 24, 26 },
            new int[] { 0, 9, 12, 20 },
            new int[] { 5, 18, 22, 30 }
        };

        var result = FindSmallestRange(arrays);
        Console.WriteLine($"[{result.L}, {result.R}]");
    }
}
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
