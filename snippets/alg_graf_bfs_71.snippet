<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Lab 7.1 - BFS</Title>
      <Shortcut>alg_graf_bfs_71</Shortcut>
      <Description>Przeszukiwanie grafu wszerz | Namespace-ready: wklejaj wewnątrz namespace { }</Description>
      <Author>bearbine</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="csharp"><![CDATA[
using System;
using System.Collections.Generic;

class Program
{
    static void BFS(Dictionary<string, List<string>> graph, string start)
    {
        Queue<string> queue = new Queue<string>();
        HashSet<string> visited = new HashSet<string>();

        visited.Add(start);
        queue.Enqueue(start);

        while (queue.Count > 0)
        {
            string vertex = queue.Dequeue();
            Console.Write(vertex + " ");

            foreach (string neighbor in graph[vertex])
            {
                if (!visited.Contains(neighbor))
                {
                    visited.Add(neighbor);
                    queue.Enqueue(neighbor);
                }
            }
        }
    }

    static void Main()
    {
        Dictionary<string, List<string>> graph = new Dictionary<string, List<string>>();

        graph["A"] = new List<string>() { "B", "E", "D" };
        graph["B"] = new List<string>() { "A", "C", "E" };
        graph["E"] = new List<string>() { "A", "B", "D", "F" };
        graph["D"] = new List<string>() { "A", "E" };
        graph["C"] = new List<string>() { "B" };
        graph["F"] = new List<string>() { "E" };

        BFS(graph, "A");
    }
}
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
