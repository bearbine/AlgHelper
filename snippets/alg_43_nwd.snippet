<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Lab 4.3 - NWD</Title>
      <Shortcut>alg_43_nwd</Shortcut>
      <Description>Algorytm Euklidesa w wersji rekurencyjnej i iteracyjnej.</Description>
      <Author>bearbine</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="csharp"><![CDATA[
using System;

class Program
{
    static int NwdRec(int a, int b)
    {
        if (b == 0) return Math.Abs(a);
        return NwdRec(b, a % b);
    }

    static int NwdIter(int a, int b)
    {
        a = Math.Abs(a);
        b = Math.Abs(b);

        while (b != 0)
        {
            int tmp = b;
            b = a % b;
            a = tmp;
        }

        return a;
    }

    static void Main()
    {
        int a = 48;
        int b = 18;

        Console.WriteLine("NWD rec: " + NwdRec(a, b));
        Console.WriteLine("NWD iter: " + NwdIter(a, b));
    }
}
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
