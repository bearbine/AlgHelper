<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Lab 5.3 - Lista wydarzeń</Title>
      <Shortcut>alg_53_wydarzenia</Shortcut>
      <Description>Lista wydarzeń sortowana po dacie. Kod jest opisany polskimi nazwami.</Description>
      <Author>bearbine</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="csharp"><![CDATA[
using System;

public class Wydarzenie
{
    private int dzien;
    private int miesiac;
    private int rok;
    private string opis;

    public Wydarzenie(int dzien, int miesiac, int rok, string opis)
    {
        this.dzien = dzien;
        this.miesiac = miesiac;
        this.rok = rok;
        this.opis = opis;
    }

    public void DodajOpis(string nowyOpis)
    {
        opis = opis + "; " + nowyOpis;
    }

    public bool PorownajDate(int dzien, int miesiac, int rok)
    {
        return this.dzien == dzien &&
               this.miesiac == miesiac &&
               this.rok == rok;
    }

    public void Wyswietl()
    {
        Console.WriteLine(dzien + "." + miesiac + "." + rok + " - " + opis);
    }
}

public class ListaWydarzen
{
    private class Wezel
    {
        public Wydarzenie Wartosc;
        public Wezel Nastepny;

        public Wezel(Wydarzenie wartosc)
        {
            Wartosc = wartosc;
            Nastepny = null;
        }
    }

    private Wezel glowa;

    public void DodajWydarzenie(int dzien, int miesiac, int rok, string opis)
    {
        Wezel aktualny = glowa;

        while (aktualny != null)
        {
            if (aktualny.Wartosc.PorownajDate(dzien, miesiac, rok))
            {
                aktualny.Wartosc.DodajOpis(opis);
                return;
            }

            aktualny = aktualny.Nastepny;
        }

        Wezel newNode = new Wezel(new Wydarzenie(dzien, miesiac, rok, opis));

        if (glowa == null)
        {
            glowa = newNode;
            return;
        }

        aktualny = glowa;

        while (aktualny.Nastepny != null)
        {
            aktualny = aktualny.Nastepny;
        }

        aktualny.Nastepny = newNode;
    }

    public void UsunWydarzenie(int dzien, int miesiac, int rok)
    {
        if (glowa == null)
        {
            return;
        }

        if (glowa.Wartosc.PorownajDate(dzien, miesiac, rok))
        {
            glowa = glowa.Nastepny;
            return;
        }

        Wezel aktualny = glowa;

        while (aktualny.Nastepny != null &&
               !aktualny.Nastepny.Wartosc.PorownajDate(dzien, miesiac, rok))
        {
            aktualny = aktualny.Nastepny;
        }

        if (aktualny.Nastepny != null)
        {
            aktualny.Nastepny = aktualny.Nastepny.Nastepny;
        }
    }

    public Wydarzenie ZnajdzWydarzenie(int dzien, int miesiac, int rok)
    {
        Wezel aktualny = glowa;

        while (aktualny != null)
        {
            if (aktualny.Wartosc.PorownajDate(dzien, miesiac, rok))
            {
                return aktualny.Wartosc;
            }

            aktualny = aktualny.Nastepny;
        }

        return null;
    }

    public void WyswietlWszystkie()
    {
        Wezel aktualny = glowa;

        while (aktualny != null)
        {
            aktualny.Wartosc.Wyswietl();
            aktualny = aktualny.Nastepny;
        }
    }
}

class Program
{
    static void Main()
    {
        ListaWydarzen lista = new ListaWydarzen();

        lista.DodajWydarzenie(25, 5, 2026, "Kolokwium z algorytmów");
        lista.DodajWydarzenie(25, 5, 2026, "Oddać projekt");
        lista.DodajWydarzenie(1, 6, 2026, "Egzamin");

        lista.WyswietlWszystkie();
    }
}
]]></Code>
