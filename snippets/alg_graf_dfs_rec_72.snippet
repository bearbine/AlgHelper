<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Lab 7.2 - DFS rekurencyjny</Title>
      <Shortcut>alg_graf_dfs_rec_72</Shortcut>
      <Description>DFS rekurencyjny dla grafu | Namespace-ready: wklejaj wewnątrz namespace { }</Description>
      <Author>bearbine</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="csharp"><![CDATA[
using System;
using System.Collections.Generic;

class Program
{
    static void DFS(Dictionary<string, List<string>> graph, string vertex, HashSet<string> visited)
    {
        visited.Add(vertex);
        Console.Write(vertex + " ");

        foreach (string neighbor in graph[vertex])
        {
            if (!visited.Contains(neighbor))
            {
                DFS(graph, neighbor, visited);
            }
        }
    }

    static void Main()
    {
        Dictionary<string, List<string>> graph = new Dictionary<string, List<string>>();

        graph["A"] = new List<string>() { "B", "E", "D" };
        graph["B"] = new List<string>() { "A", "C", "E" };
        graph["E"] = new List<string>() { "A", "B", "D", "F" };
        graph["D"] = new List<string>() { "A", "E" };
        graph["C"] = new List<string>() { "B" };
        graph["F"] = new List<string>() { "E" };

        DFS(graph, "A", new HashSet<string>());
    }
}
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
